<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme for Compose - Dark variant -->
    <style name="Theme.Sroka" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme - Dark variant -->
    <style name="Theme.Sroka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF15171C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Sroka</item>
    </style>

</resources>
