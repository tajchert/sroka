// Settings common to every target and configuration.
// Xcode 27.2, Swift 6 language mode, iOS/iPadOS 27.0 minimum (owner decision; no availability fallbacks).
SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY = 1,2
GENERATE_INFOPLIST_FILE = YES
CODE_SIGN_STYLE = Automatic
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_EMIT_LOC_STRINGS = YES
CURRENT_PROJECT_VERSION = 2
MARKETING_VERSION = 1.0

// Bundle ids: app.sroka(.dev); the share extension appends ".share".
APP_BUNDLE_ID = app.sroka$(BUNDLE_ID_SUFFIX)

// The one place the app group is named. It follows BUNDLE_ID_SUFFIX so Dev and
// Prod, which install side by side, never share (or reset) each other's store.
// Holds the database, article files and preferences (UserDefaults suite).
// Flows to the entitlements and, via Info.plist, to AppEnvironment at runtime.
APP_GROUP_IDENTIFIER = group.app.sroka$(BUNDLE_ID_SUFFIX)

// Shared Keychain access group for the session token (app + share extension).
// The team prefix is added by the entitlement ($(AppIdentifierPrefix)).
KEYCHAIN_GROUP = app.sroka$(BUNDLE_ID_SUFFIX).shared

// Enhanced Security. Pairs with the com.apple.security.hardened-process
// entitlements in App/Sroka.entitlements; the build setting alone is inert.
// Pointer authentication is off: it adds an arm64e slice to the app and extension, but the Swift package
// modules (and binary dependencies) are built for arm64 only, so a device archive cannot resolve them.
ENABLE_ENHANCED_SECURITY = YES
ENABLE_POINTER_AUTHENTICATION = NO

// DEVELOPMENT_TEAM (and any other per-machine value) lives in the optional,
// gitignored Config/Local.xcconfig. Simulator builds need none.
#include? "Local.xcconfig"
