{
  "name": "sroka",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
