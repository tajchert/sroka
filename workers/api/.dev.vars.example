# Copy to .dev.vars (gitignored). wrangler dev reads it and overrides [vars].
ENVIRONMENT=development
APP_ORIGIN=http://localhost:8787
API_ORIGIN=http://localhost:8787
CONTENT_ORIGIN=http://127.0.0.1:8787
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters-xxxxxxxx
CONTENT_URL_SIGNING_KEY=change-me-to-32-plus-random-characters-yyyyyyyy
# Optional fixed-code review account (D4):
# REVIEW_EMAIL=review@sroka.app
# REVIEW_OTP=123456
# Dev only: extra web origins (vite dev server) for Better Auth trustedOrigins + content-route CORS (D3).
DEV_ORIGINS=http://localhost:5173
# Turnstile: Cloudflare's always-pass TEST keys (any token, e.g. XXXX.DUMMY.TOKEN.XXXX, is accepted).
# Remove both lines to skip verification entirely.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Comma-separated emails allowed to use /v1/admin/* and /app/admin (D10). Empty = no admins.
ADMIN_EMAILS=
